columns if is_binary(df[c])]\n","    pool = named or anybin\n","    assert pool, f\"No 0/1 label column. Columns: {df.columns.tolist()}\"\n","    LABEL_COL = pool[0]\n","\n","df[LABEL_COL] = df[LABEL_COL].astype(int)\n","print(f\"SMILES_COL = '{SMILES_COL}' | LABEL_COL = '{LABEL_COL}'\")\n","print(\"Active fraction:\", round(df[LABEL_COL].mean(), 3), \"(expected about 0.418)\")\n","print(df[\"split_scaffold\"].value_counts().to_dict())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"r_roW_aesVac","executionInfo":{"status":"ok","timestamp":1791915324882,"user_tz":-330,"elapsed":28342,"user":{"displayName":"Smaranika","userId":"05534120014505387475"}},"outputId":"080d63a3-dd73-46b7-b902-ff765f9719fb"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n","Shape: (14208, 29) (expected 14208 rows)\n","SMILES_COL = 'can_smiles' | LABEL_COL = 'active'\n","Active fraction: 0.418 (expected about 0.418)\n","{'train': 11366, 'test': 1422, 'val': 1420}\n"]}]},{"cell_type":"code","source":["from rdkit import Chem, RDLogger\n","from rdkit.Chem import rdFingerprintGenerator\n","RDLogger.DisableLog(\"rdApp.*\")\n","\n","gen = rdFingerprintGenerator.GetMorganGenerator(radius=2, fpSize=2048)\n","X = np.array([gen.GetFingerprintAsNumPy(Chem.MolFromSmiles(s)) for s in df[SMILES_COL]],\n","             dtype=np.uint8)\n","y = df[LABEL_COL].values\n","print(\"X:\", X.shape, \"| y:\", y.shape)\n","\n","feat_dir = BASE / \"data/features\"\n","feat_dir.mkdir(parents=True, exist_ok=True)\n","np.save(feat_dir / \"morgan_r2_2048_v1.npy\", X)\n","print(\"Saved features to\", feat_dir)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"8ds5AepWsc20","executionInfo":{"status":"ok","timestamp":1791915341050,"user_tz":-330,"elapsed":16163,"user":{"displayName":"Smaranika","userId":"05534120014505387475"}},"outputId":"ed20dc58-5842-4def-898d-6f59c74f3409"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["X: (14208, 2048) | y: (14208,)\n","Saved features to /content/drive/MyDrive/kpneu_project/data/features\n"]}]},{"cell_type":"code","source":["from sklearn.linear_model import LogisticRegression\n","from xgboost import XGBClassifier\n","from sklearn.metrics import roc_auc_score, average_precision_score, matthews_corrcoef, brier_score_loss\n","\n","def make_models():\n","    return {\n","        \"RF\": RandomForestClassifier(n_estimators=500, n_jobs=-1, random_state=SEED),\n","        \"LogReg\": LogisticRegression(C=1.0, max_iter=2000),\n","        \"XGBoost\": XGBClassifier(n_estimators=400, learning_rate=0.05, max_depth=6,\n","                                 subsample=0.8, colsample_bytree=0.5,\n","                                 eval_metric=\"logloss\", random_state=SEED, n_jobs=-1),\n","    }\n","\n","def ece(y_true, p, bins=10):\n","    edges = np.linspace(0, 1, bins + 1)\n","    idx = np.clip(np.digitize(p, edges[1:-1]), 0, bins - 1)\n","    total = 0.0\n","    for b in range(bins):\n","        m = idx == b\n","        if m.any():\n","            total += m.mean() * abs(y_true[m].mean() - p[m].mean())\n","    return total\n","\n","def metrics(y_true, p, thr=0.5):\n","    return {\n","        \"roc_auc\": roc_auc_score(y_true, p),\n","        \"pr_auc\": average_precision_score(y_true, p),\n","        \"mcc\": matthews_corrcoef(y_true, (p >= thr).astype(int)),\n","        \"brier\": brier_score_loss(y_true, p),\n","        \"ece\": ece(y_true, p),\n","    }\n","\n","print(\"Baselines to beat: ROC-AUC 0.5, PR-AUC =\", round(y.mean(), 3), \"(the active fraction), MCC 0\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"A8OggZBismsg","executionInfo":{"status":"ok","timestamp":1791915342503,"user_tz":-330,"elapsed":1436,"user":{"displayName":"Smaranika","userId":"05534120014505387475"}},"outputId":"c191c28a-74f5-467f-da11-1287a0532107"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Baselines to beat: ROC-AUC 0.5, PR-AUC = 0.418 (the active fraction), MCC 0\n"]}]},{"cell_type":"code","source":["from sklearn.model_selection import StratifiedGroupKFold\n","\n","# Reloading the CSV turns empty scaffolds into NaN, so give acyclic molecules a proper name\n","df[\"scaffold\"] = df[\"scaffold\"].fillna(\"ACYCLIC\").astype(str)\n","print(\"Acyclic molecules:\", (df[\"scaffold\"] == \"ACYCLIC\").sum())\n","\n","tr = (df[\"split_scaffold\"] == \"train\").values\n","Xtr, ytr, gtr = X[tr], y[tr], df.loc[tr, \"scaffold\"].values\n","\n","cv = StratifiedGroupKFold(n_splits=5, shuffle=True, random_state=SEED)\n","rows = []\n","for name in make_models():\n","    for fold, (a, b) in enumerate(cv.split(Xtr, ytr, gtr)):\n","        # sanity check: no scaffold shared between the training and held-out parts\n","        assert not (set(gtr[a]) & set(gtr[b])), \"Scaffold leak between CV folds\"\n","        m = make_models()[name]\n","        m.fit(Xtr[a], ytr[a])\n","        r = metrics(ytr[b], m.predict_proba(Xtr[b])[:, 1])\n","        r.update(model=name, fold=fold)\n","        rows.append(r)\n","    print(\"done:\", name)\n","\n","cvres = pd.DataFrame(rows)\n","summary = cvres.groupby(\"model\")[[\"roc_auc\", \"pr_auc\", \"mcc\", \"brier\", \"ece\"]].agg([\"mean\", \"std\"]).round(3)\n","display(summary)\n","\n","(BASE / \"results\").mkdir(exist_ok=True)\n","cvres.to_csv(BASE / \"results/day5_cv_scaffold_train.csv\", index=False)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":295},"id":"DQdDueTyszyR","executionInfo":{"status":"ok","timestamp":1791915708465,"user_tz":-330,"elapsed":365957,"user":{"displayName":"Smaranika","userId":"05534120014505387475"}},"outputId":"22a9254f-13af-42fa-892b-3e75514ae322"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Acyclic molecules: 303\n","done: RF\n","done: LogReg\n","done: XGBoost\n"]},{"output_type":"display_data","data":{"text/plain":["        roc_auc        p