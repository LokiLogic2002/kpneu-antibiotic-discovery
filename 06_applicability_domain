umns if is_binary(df[c])]\n","    pool = named or anybin\n","    assert pool, f\"No 0/1 label column. Columns: {df.columns.tolist()}\"\n","    LABEL_COL = pool[0]\n","\n","df[LABEL_COL] = df[LABEL_COL].astype(int)\n","print(f\"SMILES_COL = '{SMILES_COL}' | LABEL_COL = '{LABEL_COL}'\")\n","print(\"Active fraction:\", round(df[LABEL_COL].mean(), 3), \"(expected about 0.418)\")\n","print(df[\"split_scaffold\"].value_counts().to_dict())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"aNdFmi3PrmZA","executionInfo":{"status":"ok","timestamp":1791918857399,"user_tz":-330,"elapsed":27930,"user":{"displayName":"Smaranika","userId":"05534120014505387475"}},"outputId":"94897289-480b-499c-8556-d163fc30ddef"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n","Shape: (14208, 29) (expected 14208 rows)\n","SMILES_COL = 'can_smiles' | LABEL_COL = 'active'\n","Active fraction: 0.418 (expected about 0.418)\n","{'train': 11366, 'test': 1422, 'val': 1420}\n"]}]},{"cell_type":"code","source":["from rdkit import Chem, RDLogger\n","from rdkit.Chem import rdFingerprintGenerator\n","RDLogger.DisableLog(\"rdApp.*\")\n","\n","gen = rdFingerprintGenerator.GetMorganGenerator(radius=2, fpSize=2048)\n","X = np.array([gen.GetFingerprintAsNumPy(Chem.MolFromSmiles(s)) for s in df[SMILES_COL]],\n","             dtype=np.uint8)\n","y = df[LABEL_COL].values\n","print(\"X:\", X.shape, \"| y:\", y.shape)\n","\n","feat_dir = BASE / \"data/features\"\n","feat_dir.mkdir(parents=True, exist_ok=True)\n","np.save(feat_dir / \"morgan_r2_2048_v1.npy\", X)\n","print(\"Saved features to\", feat_dir)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"GD7MioJnr24x","executionInfo":{"status":"ok","timestamp":1791918883353,"user_tz":-330,"elapsed":10424,"user":{"displayName":"Smaranika","userId":"05534120014505387475"}},"outputId":"d8f087ec-ae92-412f-93ec-58220de1e711"},"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["X: (14208, 2048) | y: (14208,)\n","Saved features to /content/drive/MyDrive/kpneu_project/data/features\n"]}]},{"cell_type":"code","source":["from sklearn.linear_model import LogisticRegression\n","from xgboost import XGBClassifier\n","from sklearn.metrics import roc_auc_score, average_precision_score, matthews_corrcoef, brier_score_loss\n","\n","def make_models():\n","    return {\n","        \"RF\": RandomForestClassifier(n_estimators=500, n_jobs=-1, random_state=SEED),\n","        \"LogReg\": LogisticRegression(C=1.0, max_iter=2000),\n","        \"XGBoost\": XGBClassifier(n_estimators=400, learning_rate=0.05, max_depth=6,\n","                                 subsample=0.8, colsample_bytree=0.5,\n","                                 eval_metric=\"logloss\", random_state=SEED, n_jobs=-1),\n","    }\n","\n","def ece(y_true, p, bins=10):\n","    edges = np.linspace(0, 1, bins + 1)\n","    idx = np.clip(np.digitize(p, edges[1:-1]), 0, bins - 1)\n","    total = 0.0\n","    for b in range(bins):\n","        m = idx == b\n","        if m.any():\n","            total += m.mean() * abs(y_true[m].mean() - p[m].mean())\n","    return total\n","\n","def metrics(y_true, p, thr=0.5):\n","    return {\n","        \"roc_auc\": roc_auc_score(y_true, p),\n","        \"pr_auc\": average_precision_score(y_true, p),\n","        \"mcc\": matthews_corrcoef(y_true, (p >= thr).astype(int)),\n","        \"brier\": brier_score_loss(y_true, p),\n","        \"ece\": ece(y_true, p),\n","    }\n","\n","print(\"Baselines to beat: ROC-AUC 0.5, PR-AUC =\", round(y.mean(), 3), \"(the active fraction), MCC 0\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Vf5vp4Y_sBfr","executionInfo":{"status":"ok","timestamp":1791918907199,"user_tz":-330,"elapsed":1703,"user":{"displayName":"Smaranika","userId":"05534120014505387475"}},"outputId":"2bed96fc-1b2d-4f4a-8541-4d24cf64866f"},"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["Baselines to beat: ROC-AUC 0.5, PR-AUC = 0.418 (the active fraction), MCC 0\n"]}]},{"cell_type":"code","source":["for v in [\"BASE\", \"df\", \"X\", \"y\", \"make_models\", \"metrics\"]:\n","    print(v, \"->\", \"OK\" if v in globals() else \"MISSING\")\n","\n","if \"df\" in globals():\n","    print(df.shape)\n","    print([c for c in df.columns if c.startswith(\"split\")])\n","if \"X\" in globals():\n","    print(\"X shape:\", X.shape)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"wlurkGW_sJch","executionInfo":{"status":"ok","timestamp":1791918921687,"user_tz":-330,"elapsed":14,"user":{"displayName":"Smaranika","userId":"05534120014505387475"}},"outputId":"22380fd0-6897-4bfd-c2ab-f0224d92a3c2"},"execution_count":6,"outputs":[{"output_type":"stream","name":"stdout","text":["BASE -> OK\n","df -> OK\n","X -> OK\n","y -> OK\n","make_models -> OK\n","metrics -> OK\n","(14208, 29)\n","['split_scaffold', 'split_random']\n","X shape: (14208, 2048)\n"]}]},{"cell_type":"code","source":["import numpy as np, pandas as pd, json\n","from sklearn.metrics import roc_auc_score\n","\n","def max_tanimoto(Xq, Xref, chunk=500):\n","    A = Xq.astype(np.float32); B = Xref.astype(np.float32)\n","    nb = B.sum(1)\n","    out = np.zeros(len(A), dtype=np.float32)\n","    for i in range(0, len(A), chunk):\n","        a = A[i:i+chunk]\n","        inter = a @ B.T\n","        union = a.sum(1)[:, None] + nb[None, :] - inter\n","        out[i:i+chunk] = (inter / np.maximum(union, 1)).max(1)\n","    return out\n","\n","trm = (df[\"split_scaffold\"] == \"train\").values\n","Xtr = X[trm]\n","\n","from sklearn.ensemble import RandomForestClassifier\n","rf = RandomForestClassifier(n_estimators=500, random_state=42, n_jobs=-1)\n","rf.fit(Xtr, y[trm])\n","\n","pt = (df[\"split_scaffold\"] == \"test\").values\n","print(\"scaffold test ROC-AUC:\", round(roc_auc_score(y[pt], rf.predict_proba(X[pt])[:, 1]), 4), \"(should be about 0.867)\")\n","\n","THRESH = 0.4\n","out_rows, bins_rows = [], []\n","edges = [0, 0.3, 0.4, 0.5, 0.7, 1.01]\n","for part in [\"val\", \"test\"]:\n","    pm = (df[\"split_scaffold\"] == part).values\n","    sim = max_tanimoto(X[pm], Xtr)\n","    p = rf.predict_proba(X[pm])[:, 1]\n","    yt = y[pm]\n","    print(part, \"median max-sim:\", round(float(np.median(sim)), 3),\n","          \"| below\", THRESH, \":\", round(float((sim < THRESH).mean()) * 100, 1), \"%\")\n","    out_rows.append(pd.DataFrame({\"set\": part, \"max_sim\": sim, \"y\": yt, \"p_rf\": p}))\n","    for lo, hi in zip(edges[:-1], edges[1:]):\n","        k = (sim >= lo) & (sim < hi)\n","        auc = roc_auc_score(yt[k], p[k]) if k.sum() >= 20 and len(set(yt[k])) == 2 else np.nan\n","        bins_rows.append({\"set\": part, \"sim_bin\": f\"{lo}-{min(hi,1.0)}\", \"n\": int(k.sum()),\n","                          \"pct_active\": round(float(yt[k].mean()) * 100, 1) if k.sum() else np.nan,\n","                          \"roc_auc\": round(auc, 3) if auc == auc else np.nan})\n","\n","ad = pd.concat(out_rows)\n","bins = pd.DataFrame(bins_rows)\n","display(bins)\n","ad.to_csv(BASE / \"results/day6_ad_similarity.csv\", index=False)\n","bins.to_csv(BASE / \"results/day6_ad_bins.csv\", index=False)\n","json.dump({\"ad_threshold\": THRESH, \"fingerprint\": \"Morgan r2 2048\", \"reference\": \"scaffold-train only (11,366)\"},\n","          open(BASE / \"results/day6_ad_threshold.json\", \"w\"))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":415},"id":"kO58ZetGsNZk","executionInfo":{"status":"ok","timestamp":1791919744591,"user_tz":-330,"elapsed":74232,"user":{"displayName":"Smaranika","userId":"05534120014505387475"}},"outputId":"04202865-1e1a-4830-c2bd-05fda02e9261"},"execution_count":10,"outputs":[{"output_type":"stream","name":"stdout","text":["scaffold test ROC-AUC: 0.8666 (should be about 0.867)\n","val median max-sim: 0.673 | below 0.4 : 8.6 %\n","test median max-sim: 0.667 | below 0.4 : 13.0 %\n"]},{"output_type":"display_data","data":{"text/plain