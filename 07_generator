ogP', 'TPSA', 'RotB'])\n","\n","    # training core\n","    core_path = find('core_unique_v2.smi')\n","    print(\"core file:\", core_path)\n","    with open(core_path) as f:\n","        core_smiles = [ln.split()[0] for ln in f if ln.strip()]\n","    data = {'training (core)': props(core_smiles)}\n","\n","    # generated sets\n","    for T in ['0.8', '1.0', '1.2']:\n","        path = find(f'gen_T{T}_unique.csv')\n","        print(f\"T={T} file:\", path)\n","        df = pd.read_csv(path)\n","        col = next((c for c in ['smiles', 'SMILES', 'can_smiles', 'canonical_smiles', 'smi']\n","                    if c in df.columns), None)\n","        if col is None:\n","            col = df.select_dtypes('object').columns[0]\n","        print(\"  using column:\", col, \"| rows:\", len(df))\n","        data[f'T={T}'] = props(df[col].tolist())\n","\n","    # medians to compare with the sheet\n","    med = pd.DataFrame({k: v.median() for k, v in data.items()}).T.round(2)\n","    print(\"\\nMedians:\\n\", med)\n","\n","    # figure\n","    fig, axes = plt.subplots(2, 2, figsize=(11, 8))\n","    for ax, p in zip(axes.ravel(), ['MW', 'logP', 'TPSA', 'RotB']):\n","        allv = np.concatenate([d[p].values for d in data.values()])\n","        bins = np.linspace(allv.min(), allv.max(), 50)\n","        for name, d in data.items():\n","            ax.hist(d[p], bins=bins, density=True, histtype='step',\n","                    linewidth=2.2 if name.startswith('training') else 1.3, label=name)\n","        ax.set_title(p)\n","        ax.legend(fontsize=7)\n","    plt.tight_layout()\n","    os.makedirs(os.path.dirname(OUT), exist_ok=True)\n","    fig.savefig(OUT, dpi=150, bbox_inches='tight')\n","    plt.show()\n","    print(\"Saved:\", OUT, \"|\", os.path.getsize(OUT)//1024, \"KB\")"],"metadata":{"id":"SG-1A8bdp1Ys","executionInfo":{"status":"ok","timestamp":1791968633373,"user_tz":-330,"elapsed":192,"user":{"displayName":"Smaranika","userId":"05534120014505387475"}},"outputId":"eacc4