t, all_set = set(core), set(allk)\n","gen = rdFingerprintGenerator.GetMorganGenerator(radius=2, fpSize=2048)\n","\n","def fp_matrix(smiles):\n","    return np.vstack([gen.GetFingerprintAsNumPy(Chem.MolFromSmiles(s)) for s in smiles]).astype(np.float32)\n","\n","def tanimoto_max(Q, R, chunk=4000):\n","    Rt = torch.tensor(R, device=dev); ra = Rt.sum(1)\n","    out = []\n","    for i in range(0, len(Q), chunk):\n","        q = torch.tensor(Q[i:i+chunk], device=dev); qa = q.sum(1)\n","        inter = q @ Rt.T\n","        sim = inter / (qa[:, None] + ra[None, :] - inter)\n","        out.append(sim.max(1).values.cpu().numpy())\n","    return np.concatenate(out)\n","\n","def internal_div(X, n=2000, seed=42):\n","    idx = np.random.default_rng(seed).choice(len(X), min(n, len(X)), replace=False)\n","    q = torch.tensor(X[idx], device=dev); a = q.sum(1)\n","    inter = q @ q.T\n","    sim = inter / (a[:, None] + a[None, :] - inter)\n","    m = len(idx)\n","    return float(1 - (sim.sum() - m) / (m * (m - 1)))\n","\n","PROPS = [\"MW\", \"logP\", \"TPSA\", \"HBD\", \"HBA\", \"RotB\", \"AromRings\"]\n","def props(m):\n","    return [Descriptors.MolWt(m), Crippen.MolLogP(m), rdMolDescriptors.CalcTPSA(m),\n","            Lipinski.NumHDonors(m), Lipinski.NumHAcceptors(m),\n","            rdMolDescriptors.CalcNumRotatableBonds(m), rdMolDescriptors.CalcNumAromaticRings(m)]\n","def prop_table(smiles, n=20000, seed=42):\n","    smiles = list(smiles)\n","    if len(smiles) > n:\n","        smiles = list(np.random.default_rng(seed).choice(smiles, n, replace=False))\n","    return pd.DataFrame([props(Chem.MolFromSmiles(s)) for s in smiles], columns=PROPS)\n","\n","Xcore, Xall = fp_matrix(core), fp_matrix(allk)\n","ref_props = prop_table(core)\n","ref_div = internal_div(Xcore)\n","\n","rows, props_by_T = {}, {\"training (core)\": ref_props}\n","for T in TEMPS:\n","    raw = pd.read_csv(f\"{BASE}/results/day10/sample_T{T}.csv\")\n","    smi = raw.SMILES.astype(str)\n","    mols = [Chem.MolFromSmiles(s) for s in smi]\n","    can = [Chem.MolToSmiles(m, isomericSmiles=False) for m in mols if m is not None]\n","    raw_unique = sorted(set(can))\n","    uniq = [s for s in raw_unique if Chem.MolFromSmiles(s) is not None]   # drop the rare SMILES that cannot be read back\n","    n_bad = len(raw_unique) - len(uniq)\n","    X = fp_matrix(uniq)\n","    mc, ma = tanimoto_max(X, Xcore), tanimoto_max(X, Xall)\n","\n","    pd.DataFrame({\"smiles\": uniq, \"maxsim_core\": mc, \"maxsim_all\": ma}).to_csv(\n","        f\"{BASE}/results/day10/gen_T{T}_unique.csv\", index=False)\n","    props_by_T[f\"T={T}\"] = prop_table(uniq)\n","\n","    rows[f\"T={T}\"] = {\n","        \"sampled\": len(smi),\n","        \"validity_%\": round(len(can)/len(smi)*100, 1),\n","        \"unique_%\": round(len(raw_unique)/len(can)*100, 1),\n","        \"reparse_failed\": n_bad,\n","        \"exact_core_%\": round(sum(u in core_set for u in uniq)/len(uniq)*100, 1),\n","        \"exact_all_%\": round(sum(u in all_set for u in uniq)/len(uniq)*100, 1),\n","        \"novel_all_<0.7_%\": round((ma < 0.7).mean()*100, 1),\n","        \"novel_all_<0.8_%\": round((ma < 0.8).mean()*100, 1),\n","        \"median_maxsim_all\": round(float(np.median(ma)), 2),\n","        \"internal_diversity\": round(internal_div(X), 3),\n","        \"valid_unique_novel<0.7_%_of_sampled\": round((ma < 0.7).sum()/len(smi)*100, 1),\n","    }\n","\n","res = pd.DataFrame(rows).T\n","res.loc[\"training (core), diversity ref\"] = {\"internal_diversity\": round(ref_div, 3)}\n","print(res.to_string())\n","res.to_csv(f\"{BASE}/results/day10_temperature_comparison.csv\")\n","\n","med = pd.DataFrame({k: v.median() for k, v in props_by_T.items()}).T.round(2)\n","print(\"\\nMedian properties:\"); print(med.to_string())\n","med.to_csv(f\"{BASE}/results/day10_property_medians.csv\")\n","\n","fig, ax = plt.subplots(2, 2, figsize=(11, 8))\n","for a, p in zip(ax.ravel(), [\"MW\", \"logP\", \"TPSA\", \"RotB\"]):\n","    for k, v in props_by_T.items():\n","        a.hist(v[p], bins=40, density=True, histtype=\"step\", label=k, linewidth=2 if k.startswith(\"training\") else 1.2)\n","    a.set_title(p); a.legend(fontsize=7)\n","plt.tight_layout(); plt.savefig(f\"{BASE}/results/day10_properties.png\", dpi=150); plt.show()\n","\n","sp = res.loc[[f\"T={T}\" for T in TEMPS], \"unique_%\"].astype(float)\n","if sp.max() - sp.min() < 0.5:\n","    print(\"\\nWARNING: uniqueness is nearly identical at all temperatures: the temperature setting may have been ignored.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":659},"id":"Jcci1rQJf16s","executionInfo":{"status":"ok","timestamp":1791967556231,"user_tz":-330,"elapsed":163437,"user":{"displayName":"Smaranika","userId":"05534120014505387475"}},"outputId":"be1af09c-2fe0-48ee-cf87-37c60ec7ebaf"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["                                sampled  validity_%  unique_%  reparse_failed  exact_core_%  exact_all_%  novel_all_<0.7_%  novel_all_<0.8_%  median_maxsim_all  internal_diversity  valid_unique_novel<0.7_%_of_sampled\n","T=0.8                           50000.0        97.1      66.7             0.0           6.0          6.3              59.3              77.7               0.65               0.870                                 38.3\n","T=1.0                           50000.0        94.3      83.1             0.0           4.4          4.6              71.2              85.3               0.57               0.876                                 55.8\n","T=1.2                           50000.0        89.7      93.6             0.0           2.9          3.0              81.5              91.3               0.46               0.882                                 68.5\n","training (core), diversity ref      NaN         NaN       NaN             NaN           NaN          NaN               NaN               NaN                NaN               0.862                      